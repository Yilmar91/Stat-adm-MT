n8n.asistente-ia.cloud {
	reverse_proxy http://127.0.0.1:5678
}
http://gateway.terravinci.ai {
	reverse_proxy 127.0.0.1:3000
}
publisher.asistente-ia.cloud {
	request_body {
		max_size 500mb
	}
	handle /api/* {
		reverse_proxy localhost:8008
	}
	handle /auth/* {
		reverse_proxy localhost:8008
	}
	handle /uploads/* {
		reverse_proxy localhost:8008
	}
	handle /health {
		reverse_proxy localhost:8008
	}
	handle {
		reverse_proxy localhost:8009
	}
}

