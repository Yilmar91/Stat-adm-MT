agents.asistente-ia.cloud {
    header Access-Control-Allow-Origin *
    header Access-Control-Allow-Headers x-api-key,x-admin-key,Content-Type
    header Access-Control-Allow-Methods POST,GET,DELETE,OPTIONS
    reverse_proxy localhost:3640
}

