design.asistente-ia.cloud {
    root * /opt/terravinci-design-system/public
    file_server
    header Access-Control-Allow-Origin *
    header Cache-Control "public, max-age=3600"
}

webhook.asistente-ia.cloud {
    reverse_proxy localhost:8023
}

simulador.asistente-ia.cloud {
    reverse_proxy localhost:8024
}

ia.asistente-ia.cloud {
    reverse_proxy localhost:3200
}

estadisticas.grupoterravinci.cloud {
    root * "/opt/STAT - ADM MT"
    php_fastcgi unix//run/php/php8.1-fpm.sock
    @api path /api/*
    header @api {
        Access-Control-Allow-Origin  *
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }
    @options method OPTIONS
    respond @options 204
    file_server
    try_files {path} /index.html
}

staff-terravinci.asistente-ia.cloud {
    root * /opt/staff-terravinci-app/dist
    file_server
    try_files {path} /index.html
}

api.staff-terravinci.asistente-ia.cloud {
    reverse_proxy localhost:8010
}

db.staff-terravinci.asistente-ia.cloud {
    reverse_proxy localhost:8011
}
